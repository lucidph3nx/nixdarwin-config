#!/usr/bin/env bash
# macOS password prompt using osascript

# Extract the prompt from arguments (look for -p flag)
prompt="Enter Password"
while [[ $# -gt 0 ]]; do
    case $1 in
        -p)
            prompt="$2"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

# Show password dialog
osascript -e "text returned of (display dialog \"$prompt\" default answer \"\" with hidden answer)" 2>/dev/null
